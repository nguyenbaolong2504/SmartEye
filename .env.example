APP_ENV=development
DATABASE_URL=sqlite:///./backend/data/smarteye.db
COOKIE_SECURE=false
SEED_DEMO=true
# Set these BEFORE the first startup. No hardcoded administrator password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
GOOGLE_ROUTES_API_KEY=
# Browser key is separate; restrict by HTTP referrer and Maps JavaScript API.
GOOGLE_MAPS_BROWSER_KEY=
YOLO_MODEL_PATH=backend/data/models/yolo11n.pt
MAX_UPLOAD_MB=150
MAX_VIDEO_SECONDS=300
OBSERVATION_TTL_MINUTES=15
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
APP_BASE_URL=http://localhost:5173
# Docker only. Use a long alphanumeric password (URL-safe).
POSTGRES_PASSWORD=
