APP_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/
MONGODB_DB=smarteye
# Leave URI empty if using the individual connection fields below.
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=smarteye
# Generated automatically for Docker by scripts/setup_env.py.
MONGO_ROOT_USERNAME=smarteye_root
MONGO_ROOT_PASSWORD=
MONGODB_DOCKER_PORT=27018
FRONTEND_PORT=8080
COOKIE_SECURE=false
SEED_DEMO=true
ADMIN_EMAIL=
ADMIN_PASSWORD=
GOOGLE_ROUTES_API_KEY=
GOOGLE_MAPS_BROWSER_KEY=
YOLO_MODEL_PATH=backend/data/models/yolo11n.pt
MAX_UPLOAD_MB=150
MAX_VIDEO_SECONDS=300
OBSERVATION_TTL_MINUTES=15
SMTP_HOST=
