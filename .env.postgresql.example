# Copy into .env for a PostgreSQL server installed on this computer.
APP_ENV=development
# Leave empty to use the individual fields below.
DATABASE_URL=
DB_ENGINE=postgresql
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=smarteye
POSTGRES_USER=smarteye
POSTGRES_PASSWORD=
COOKIE_SECURE=false
SEED_DEMO=true
ADMIN_EMAIL=
ADMIN_PASSWORD=
GOOGLE_ROUTES_API_KEY=
GOOGLE_MAPS_BROWSER_KEY=
YOLO_MODEL_PATH=backend/data/models/yolo11n.pt
MAX_UPLOAD_MB=150
MAX_VIDEO_SECONDS=300
OBSERVATION_TTL_MINUTES=15
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
APP_BASE_URL=http://localhost:5173
