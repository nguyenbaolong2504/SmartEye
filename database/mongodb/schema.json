{
  "traffic_samples": {
    "$jsonSchema": {
      "bsonType": "object",
      "required": [
        "_id",
        "sample_key",
        "segment_id",
        "observed_at",
        "score",
        "density",
        "count",
        "source"
      ],
      "properties": {
        "_id": {
          "bsonType": [
            "int",
            "long"
          ]
        },
        "sample_key": {
          "bsonType": "string"
        },
        "segment_id": {
          "bsonType": [
            "int",
            "long"
          ]
        },
        "observed_at": {
          "bsonType": "string"
        },
        "score": {
          "bsonType": [
            "int",
            "long",
            "double",
            "decimal"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "count": {
          "bsonType": [
            "int",
            "long"
          ],
          "minimum": 0
        },
        "density": {
          "enum": [
            "LOW",
            "NORMAL",
            "HIGH"
          ]
        },
        "source": {
          "bsonType": "string"
        }
      }
    }
  },
  "users": {
    "$jsonSchema": {
      "bsonType": "object",
      "required": [
        "_id",
        "email",
        "name",
        "password",
        "role",
        "active",
        "created_at"
      ],
      "properties": {
        "_id": {
          "bsonType": [
            "int",
            "long"
          ]
        },
        "email": {
          "bsonType": "string"
        },
        "name": {
          "bsonType": "string"
        },
        "password": {
          "bsonType": "string"
        },
        "role": {
          "enum": [
            "user",
            "analyst",
            "admin"
          ]
        },
        "active": {
          "bsonType": "bool"
        },
        "auth_version": {
          "bsonType": [
            "int",
            "long"
          ]
        },
        "created_at": {
          "bsonType": "string"
        }
      }
    }
  },
  "segments": {
    "$jsonSchema": {
      "bsonType": "object",
      "required": [
        "_id",
        "name",
        "start_node",
        "end_node",
        "distance_km",
        "geometry",
        "active",
        "is_demo"
      ],
      "properties": {
        "_id": {
          "bsonType": [
            "int",
            "long"
          ]
        },
        "name": {
          "bsonType": "string"
        },
        "start_node": {
          "bsonType": "string"
        },
        "end_node": {
          "bsonType": "string"
        },
        "distance_km": {
          "bsonType": [
            "int",
            "long",
            "double",
            "decimal"
          ],
          "minimum": 0.05
        },
        "geometry": {
          "bsonType": "array",
          "minItems": 2
        },
        "active": {
          "bsonType": "bool"
        },
        "is_demo": {
          "bsonType": "bool"
        }
      }
    }
  },
  "cameras": {
    "$jsonSchema": {
      "bsonType": "object",
      "required": [
        "_id",
